# Copy to .env and fill in. Never commit .env.
SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase dashboard → Project Settings → API Keys → Secret keys (starts with sb_secret_)
SUPABASE_SECRET_KEY=sb_secret_xxx
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
# Comma-separated nicknames excluded from the "sessions by other surfers" metric
CORE_NICKNAMES=finn,dad
PORT=3001
